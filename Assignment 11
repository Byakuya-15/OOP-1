#include <iostream>
using namespace std;

template <class T>
void swapValues(T &a, T &b)
{
    T temp;
    temp = a;
    a = b;
    b = temp;
}

int main()
{
    int employee1 = 101, employee2 = 102;
    float priority1 = 2.5, priority2 = 4.5;
    char room1 = 'A', room2 = 'B';

    cout << "Before Swapping:" << endl;
    cout << "Employee IDs: " << employee1 << " " << employee2 << endl;
    cout << "Priorities: " << priority1 << " " << priority2 << endl;
    cout << "Room Numbers: " << room1 << " " << room2 << endl;

    swapValues(employee1, employee2);
    swapValues(priority1, priority2);
    swapValues(room1, room2);

    cout << "\nAfter Swapping:" << endl;
    cout << "Employee IDs: " << employee1 << " " << employee2 << endl;
    cout << "Priorities: " << priority1 << " " << priority2 << endl;
    cout << "Room Numbers: " << room1 << " " << room2 << endl;

    return 0;
}
